#include <windows.h>
#include "resources.h"

IDI_YOUCAM ICON "assets/youcam.ico"

// Keep the full upstream license in the standalone executable.
101 RCDATA "LICENSE"

1 VERSIONINFO
FILEVERSION 2,1,1,0
PRODUCTVERSION 2,1,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "YouCam for Windows"
            VALUE "FileVersion", "2.1.1"
            VALUE "ProductName", "YouCam for Windows"
            VALUE "ProductVersion", "2.1.1"
            VALUE "OriginalFilename", "YouCam.exe"
            VALUE "LegalCopyright", "Copyright (c) 2026 antirez. MIT License."
            VALUE "Comments", "Fork of https://github.com/antirez/youcam, adapted for Windows."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
